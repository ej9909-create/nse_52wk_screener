# Copy to  vm/.env  on the VM and fill in. NEVER commit the real file.
#
# GitHub token — a fine-grained token with "Actions: Read and write" on this
# repo, OR a classic token with the `repo` + `workflow` scopes.
GH_TOKEN=

# Repo coordinates (defaults shown; usually no need to change).
GH_OWNER=ej9909-create
GH_REPO=nse_52wk_screener
GH_WORKFLOW=update-daily.yml

# Telegram failure alerts (recommended). Reuse a bot you already have; the chat
# id is your user id or a channel id like -1001234567890.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
