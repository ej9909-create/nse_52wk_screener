# Copy this to .streamlit/secrets.toml for local runs,
# and paste the same line into Streamlit Cloud ▸ Manage app ▸ Settings ▸ Secrets.
# Change this value any time to instantly revoke the old passcode.
app_password = "change-me"

# Supabase (price-alert store). From Supabase ▸ Project Settings ▸ API.
# Use the service_role key (secret, server-side only) — NOT the anon key.
SUPABASE_URL = "https://YOUR-PROJECT-ref.supabase.co"
SUPABASE_SERVICE_KEY = "your-service-role-key"
